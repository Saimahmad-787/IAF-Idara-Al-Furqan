rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Official Institute Logo and public branding
    match /branding/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'Teacher';
    }

    // Student Photographs (Teacher managed, viewable by authorized parent)
    match /institutes/{instituteId}/students/{studentId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.auth.token.instituteId == instituteId && 
        request.auth.token.role == 'Teacher';
    }

    // Private Payment Slips / Evidence (Accessible only to submitting parent and teacher)
    match /institutes/{instituteId}/payments/{paymentId}/{fileName} {
      allow read, write: if request.auth != null &&
        request.auth.token.instituteId == instituteId;
    }
  }
}
